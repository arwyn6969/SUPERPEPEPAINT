PORT=3101
BIND_HOST=127.0.0.1
APP_ENV=development

# Resend must verify the domain used by this sender address.
RESEND_ENABLED=false
RESEND_API_KEY=
SUBMISSION_FROM_EMAIL=PEPEPAINT <submissions@pepepaint.journeypaint.fun>
SUBMISSION_TO_EMAIL=owner@example.com

# Telegram bot credentials for the private submissions channel.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Use an absolute path in production, outside the public web root.
SUBMISSION_STORAGE_ROOT=./var/submissions
# The browser exports a 400x560 canvas and caps submitted GIFs at 32 frames.
SUBMISSION_MAX_FILE_BYTES=12582912
SUBMISSION_MAX_ARTWORK_WIDTH=400
SUBMISSION_MAX_ARTWORK_HEIGHT=560
SUBMISSION_MAX_ARTWORK_PIXELS=224000
SUBMISSION_MAX_GIF_FRAMES=32
SUBMISSION_RATE_LIMIT_WINDOW_MS=900000
SUBMISSION_RATE_LIMIT_MAX=5
SUBMISSION_RATE_LIMIT_MAX_CLIENTS=10000
SUBMISSION_CONCURRENT_MAX=2

# Durable delivery outbox. Leases recover work after a crashed process; retry
# delays use bounded exponential backoff. A zero scan interval disables only
# the periodic timer (startup and request-time processing still run).
SUBMISSION_DELIVERY_LEASE_MS=120000
SUBMISSION_DELIVERY_TIMEOUT_MS=30000
SUBMISSION_OUTBOX_INTERVAL_MS=30000
SUBMISSION_OUTBOX_BATCH_SIZE=20
SUBMISSION_RETRY_BASE_DELAY_MS=5000
SUBMISSION_RETRY_MAX_DELAY_MS=900000
SUBMISSION_RETRY_MAX_ATTEMPTS=10
# Random delay added to ordinary exponential retries (0-50 percent).
SUBMISSION_RETRY_JITTER_PERCENT=20
# Ambiguous sends wait longer. Telegram enters manual review after this many
# uncertain attempts because Bot API media sends have no idempotency key.
SUBMISSION_UNCERTAIN_RETRY_DELAY_MS=300000
SUBMISSION_UNCERTAIN_MAX_ATTEMPTS=2
# Clamp an excessive Telegram parameters.retry_after to one hour.
TELEGRAM_RETRY_AFTER_MAX_MS=3600000
SUBMISSION_STAGING_MAX_AGE_MS=3600000

# Reject new archives before this total is exceeded. Set to 0 only when an
# external filesystem quota and capacity alert are already in place.
SUBMISSION_STORAGE_MAX_BYTES=5368709120

# Disabled by default because archives may be operational records. Set a
# positive number only after agreeing a retention policy and backup process.
SUBMISSION_STORAGE_RETENTION_DAYS=0

# Cached readiness recovery checks. GET /api/ready never runs the probe itself.
READINESS_PROBE_INTERVAL_MS=30000
READINESS_PROBE_TIMEOUT_MS=5000
READINESS_RETRY_AFTER_SECONDS=10
