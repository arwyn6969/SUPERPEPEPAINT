# Add these locations inside the existing pepepaint.journeypaint.fun server
# block. The named zones are defined in nginx-http.conf.example.
location = /api/health {
	proxy_pass http://127.0.0.1:3101;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
}

location = /api/submissions {
	limit_except POST { deny all; }
	client_max_body_size 13m;
	limit_req zone=pepepaint_submissions burst=2 nodelay;
	limit_conn pepepaint_submission_connections 4;
	limit_req_status 429;
	limit_conn_status 429;
	proxy_pass http://127.0.0.1:3101;
	proxy_http_version 1.1;
	proxy_request_buffering on;
	client_body_timeout 30s;
	proxy_connect_timeout 5s;
	proxy_send_timeout 30s;
	proxy_read_timeout 90s;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
}
